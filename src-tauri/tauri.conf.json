{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notinger",
  "version": "1.0.3",
  "identifier": "com.bloem.notinger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Notinger",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "backgroundColor": "#FAF9F8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Frybex/notinger/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3Mjg0MjI2QzY4RjgwNDMKUldSRGdJL0dKa0lvcHdSRjdkRHh5UWlPVGd0Q0VnUVQ5Wko0K0sxZFNFaGdSL0NjTExNQ2dQNGsK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Schéma Excalidraw",
        "description": "Schéma Notinger / Excalidraw",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.excalidraw+json",
        "exportedType": {
          "identifier": "com.bloem.notinger.excalidraw",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ]
  }
}
